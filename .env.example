# Signal Stack Environment Variables

# Application
APP_NAME="Signal Stack Intelligence Engine"
APP_ENV=development # or "production"
HOST="0.0.0.0"
PORT=8000

# CORS Configuration
# Set to "*" for open access or comma-separated domains in production:
# CORS_ORIGINS="https://your-signal-stack.vercel.app,http://localhost:5173"
CORS_ORIGINS="*"

# Database Configuration (SQLite default for local dev, PostgreSQL for hosted production)
DATABASE_URL="sqlite:///./signal_stack.db"
# For Hosted PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL="postgresql://user:password@host:5432/signal_stack"

# Google Gemini API Key (Get free tier key from https://aistudio.google.com/)
# If left empty, the application uses the built-in domain reasoning fallback engine.
GEMINI_API_KEY=""

# Background Automation Schedulers
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE="UTC"
CRAWL_INTERVAL_HOURS=24
DEFAULT_COMPANY_ID="meetuniversity"

# Weekly Brief Schedule (Every Monday 08:00 UTC)
WEEKLY_REPORT_CRON_DAY="mon"
WEEKLY_REPORT_CRON_HOUR=8
WEEKLY_REPORT_CRON_MINUTE=0
MONTHLY_AUDIT_DAY=1

# Frontend Configuration (Used when building frontend)
# Set to your hosted backend URL on Render (e.g. https://signal-stack-api.onrender.com)
VITE_API_BASE_URL=""
